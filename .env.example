# Email Configuration
# These environment variables are required for contact form functionality
# Copy this file to .env.local and fill in your actual values

# Email service configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=support@maisoncaldor.com
EMAIL_PASSWORD=your-email-password-here

# For Gmail, you may need to:
# 1. Enable 2-factor authentication
# 2. Generate an "App Password" specifically for this application
# 3. Use the App Password as EMAIL_PASSWORD (not your regular password)

# For other email providers:
# - Update EMAIL_HOST to your provider's SMTP server
# - Update EMAIL_PORT if needed (587 for TLS, 465 for SSL)
# - Set EMAIL_SECURE=true if using port 465