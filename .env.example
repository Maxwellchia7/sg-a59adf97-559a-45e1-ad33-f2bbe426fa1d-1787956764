# Email Configuration for Hostinger SMTP
# These environment variables are required for contact form functionality
# Copy this file to .env.local and fill in your actual password

# Hostinger SMTP Configuration (Primary - Port 465/SSL)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=support@maisoncaldor.com
EMAIL_PASSWORD=your-actual-email-password-here

# Alternative Configuration (If port 465 causes SSL errors, use port 587/TLS)
# EMAIL_HOST=smtp.hostinger.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=support@maisoncaldor.com
# EMAIL_PASSWORD=your-actual-email-password-here

# IMPORTANT SECURITY NOTES:
# - NEVER commit .env.local to git (already in .gitignore)
# - Use the actual mailbox password from Hostinger
# - For production (Vercel), add these same variables in project settings
# - Contact form submissions will be sent to support@maisoncaldor.com
# - Reply-To will be set to the customer's email for easy replies